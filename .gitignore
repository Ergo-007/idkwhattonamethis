# pyenv
#   For a library or package, you might want to ignore these files since the Python version
#   is managed by the end user. For an application, you might want to commit them.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in cases where the lockfile contains platform-specific dependencies, it may be excluded.
#Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds. It's usually recommended to commit this.
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm-python
.pdm-python
.pdm-build/

# pipx
.pipx/

# PEP 582; used by e.g. ://github.com, pdm
__pypackages__/

